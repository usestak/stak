# STAK Cloud (apps/web) environment. Copy to .env.local and fill in.
# Never commit real secrets.

# Supabase project (Project Settings -> API). Third-party names are unchanged.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never expose to the browser, CLI, or logs.
SUPABASE_SERVICE_ROLE_KEY=

# First-party STAK variables. STAK_* is preferred; the matching STACK_* name is
# accepted as a legacy alias (setting both of a pair to different values is an error).

# Public URL of this web app (used to build CLI verification links).
STAK_APP_URL=http://localhost:3000

# High-entropy secret used to sign short-lived snapshot upload/download tickets.
STAK_TICKET_SECRET=

# Private Storage bucket for snapshot archives. (Bucket name unchanged for
# compatibility with existing storage.)
STAK_SNAPSHOT_BUCKET=stack-snapshots

# Maximum accepted snapshot archive size in bytes (default 200 MiB).
STAK_MAX_SNAPSHOT_BYTES=209715200
