# Stack Cloud (apps/web) environment. Copy to .env.local and fill in.
# Never commit real secrets.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never expose to the browser, CLI, or logs.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this web app (used to build CLI verification links).
STACK_APP_URL=http://localhost:3000

# High-entropy secret used to sign short-lived snapshot upload/download tickets.
STACK_TICKET_SECRET=

# Private Storage bucket for snapshot archives.
STACK_SNAPSHOT_BUCKET=stack-snapshots

# Maximum accepted snapshot archive size in bytes (default 200 MiB).
STACK_MAX_SNAPSHOT_BYTES=209715200
