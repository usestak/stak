    "@stack/cloud-server": "workspace:*",
    "@stack/core": "workspace:*",
    "@stack/scanner": "workspace:*",
    "@stack/shared": "workspace:*",
    "@stack/spec": "workspace:*",
    "@stack/store": "workspace:*",
    "commander": "15.0.0"
  }
}
