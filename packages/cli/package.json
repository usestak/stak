{
  "name": "@memstk/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Memory STAK — the control plane for portable AI agent environments.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usestak/stak.git"
  },
  "bugs": {
    "url": "https://github.com/usestak/stak/issues"
  },
  "homepage": "https://github.com/usestak/stak#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "stak": "./dist/bin.js"
  },
  "files": [
