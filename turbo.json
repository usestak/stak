{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "STACK_APP_URL",
        "STACK_TICKET_SECRET",
        "STACK_SNAPSHOT_BUCKET",
        "STACK_MAX_SNAPSHOT_BYTES"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    }
  }
}
