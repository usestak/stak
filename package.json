  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.1",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "tsup": "8.5.0",
    "vitest": "5.0.1"
  }
