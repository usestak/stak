{
  "name": "stack-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "The control plane for portable AI agent environments.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
